{
  "name": "interview-helper",
  "productName": "Interview Helper",
  "version": "0.1.0",
  "description": "A real-time AI companion for practice interviews: live transcription, interview-flow aware answer suggestions, companion overlay and screen analysis — powered by Replicate.",
  "author": "Interview Helper Contributors <interview-helper@users.noreply.github.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/batsearchlight/ai-interview-assistant.git"
  },
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "latest",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "io.github.batsearchlight.interview-helper",
    "productName": "Interview Helper",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "files": [
      "main.js",
      "preload.js",
      "overlay-preload.js",
      "companion-preload.js",
      "renderer/**",
      "assets/icon.png",
      "assets/icon.ico"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "win": {
      "target": ["nsis", "portable"],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "portable": {
      "artifactName": "${productName}-${version}-${os}-${arch}-portable.${ext}"
    },
    "mac": {
      "target": [
        { "target": "dmg", "arch": ["universal"] },
        { "target": "zip", "arch": ["universal"] }
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.png"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "icon": "build/icon.png",
      "category": "Utility",
      "maintainer": "interview-helper@users.noreply.github.com"
    }
  }
}
